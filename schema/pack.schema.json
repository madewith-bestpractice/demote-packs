{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madewith-bestpractice/demote-packs/schema/pack.schema.json",
  "title": "Demote button pack",
  "description": "A declarative set of custom buttons for the Demote remote app. Packs are data only: no scripts, expressions or response parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "name", "description", "vendor", "author", "icon", "engine", "network", "buttons"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "description": "Reverse-DNS id, unique across the directory. Must match the file name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+){2,}$",
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "name": { "$ref": "#/$defs/localized", "description": "At most 32 characters per language." },
    "description": { "$ref": "#/$defs/localized", "description": "One short sentence, at most 120 characters per language." },
    "vendor": { "type": "string", "minLength": 1, "maxLength": 40 },
    "author": { "type": "string", "minLength": 1, "maxLength": 60 },
    "icon": { "type": "string", "description": "A name from schema/icons.json." },
    "accent": { "enum": ["amber", "blue", "green", "orange", "pink", "purple", "red", "teal"] },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "engine": { "enum": ["http", "home_assistant"] },
    "network": {
      "description": "local: requests may only reach private, link-local or .local hosts. internet: allowed only in reviewed packs, with a stronger disclosure.",
      "enum": ["local", "internet"]
    },
    "variables": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/variable" }
    },
    "buttons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/button" }
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z0-9]{2,3})?$": { "type": "string", "minLength": 1 }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "type", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "scope": { "enum": ["pack", "button"] },
        "type": { "enum": ["text", "number", "choice", "host", "port", "secret", "ha_entity"] },
        "label": { "$ref": "#/$defs/localized" },
        "placeholder": { "type": "string", "maxLength": 60 },
        "default": { "type": ["string", "number"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 200 },
              "label": { "$ref": "#/$defs/localized" }
            }
          }
        },
        "domain": {
          "description": "ha_entity only: the Home Assistant domain to pick from, e.g. media_player.",
          "type": "string",
          "pattern": "^[a-z_]+$"
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "choice" } } }, "then": { "required": ["options"] } },
        { "if": { "properties": { "type": { "const": "ha_entity" } } }, "then": { "required": ["domain"] } }
      ]
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "icon"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "label": { "$ref": "#/$defs/localized", "description": "At most 24 characters per language." },
        "icon": { "type": "string" },
        "repeat": { "type": "boolean", "description": "Hold to repeat, like the TV volume keys." },
        "variables": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/variable" }
        },
        "request": { "$ref": "#/$defs/httpRequest" },
        "service": { "$ref": "#/$defs/haService" }
      },
      "oneOf": [
        { "required": ["request"], "not": { "required": ["service"] } },
        { "required": ["service"], "not": { "required": ["request"] } }
      ]
    },
    "httpRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT"] },
        "url": { "type": "string", "pattern": "^https?://", "maxLength": 2000 },
        "headers": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$" },
              "value": { "type": "string", "maxLength": 1000 }
            }
          }
        },
        "contentType": { "enum": ["application/json", "text/plain", "application/x-www-form-urlencoded"] },
        "body": {
          "description": "A string, or a JSON value when contentType is application/json.",
          "type": ["string", "object", "array"]
        }
      }
    },
    "haService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "pattern": "^[a-z_]+\\.[a-z0-9_]+$", "description": "domain.service, e.g. media_player.select_source." },
        "target": { "type": "object" },
        "data": { "type": "object" }
      }
    }
  }
}
