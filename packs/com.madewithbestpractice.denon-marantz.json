              }
            },
            {
              "value": "BT",
              "label": {
                "en": "Bluetooth",
                "es": "Bluetooth"
              }
            }
          ]
        }
      ],
      "request": {
        "method": "GET",
        "url": "http://{{host}}:{{port}}/goform/formiPhoneAppDirect.xml?Z2{{source}}"
      }
    }
  ]
}
