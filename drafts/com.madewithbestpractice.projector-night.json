{
  "schema": 1,
  "id": "com.madewithbestpractice.projector-night",
  "version": "0.1.0",
  "name": {
    "en": "Projector night",
    "es": "Noche de proyector"
  },
  "description": {
    "en": "Lower the screen, turn on the projector, dim the room and set the receiver with Home Assistant.",
    "es": "Baja la pantalla, enciende el proyector, oscurece la sala y prepara el receptor con Home Assistant."
  },
  "vendor": "Home Assistant",
  "author": "Made with Best Practice",
  "icon": "scene",
  "accent": "teal",
  "engine": "home_assistant",
  "network": "local",
  "variables": [
    {
      "id": "lights",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Lights (a light or a group)",
        "es": "Luces (una luz o un grupo)"
      },
      "domain": "light"
    },
    {
      "id": "screen",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Projector screen, if motorized",
        "es": "Pantalla del proyector, si es motorizada"
      },
      "domain": "cover",
      "optional": true
    },
    {
      "id": "projector_switch",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Projector switch, if any",
        "es": "Interruptor del proyector, si tienes"
      },
      "domain": "switch",
      "optional": true
    },
    {
      "id": "ir_hub",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "IR hub, if the projector uses one",
        "es": "Emisor IR, si el proyector usa uno"
      },
      "domain": "remote",
      "optional": true
    },
    {
      "id": "ir_device",
      "scope": "pack",
      "type": "text",
      "label": {
        "en": "IR device name, if your hub uses one",
        "es": "Nombre del equipo IR, si tu emisor lo usa"
      },
      "placeholder": "projector",
      "optional": true
    },
    {
      "id": "ir_command",
      "scope": "pack",
      "type": "text",
      "label": {
        "en": "IR power command",
        "es": "Comando IR de encendido"
      },
      "placeholder": "power",
      "default": "power"
    },
    {
      "id": "receiver",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Receiver, if any",
        "es": "Receptor, si tienes"
      },
      "domain": "media_player",
      "optional": true
    },
    {
      "id": "movie_input",
      "scope": "pack",
      "type": "text",
      "label": {
        "en": "Receiver input for the projector",
        "es": "Entrada del receptor para el proyector"
      },
      "placeholder": "HDMI 1",
      "optional": true
    }
  ],
  "buttons": [
    {
      "id": "showtime",
      "label": {
        "en": "Showtime",
        "es": "Empieza la función"
      },
      "icon": "scene",
      "steps": [
        { "button": "screen_down" },
        { "button": "projector_on" },
        { "button": "projector_on_ir" },
        { "button": "lights_off" },
        { "button": "receiver_input" }
      ]
    },
    {
      "id": "screen_down",
      "label": {
        "en": "Screen down",
        "es": "Bajar pantalla"
      },
      "icon": "blinds",
      "service": {
        "action": "cover.close_cover",
        "target": {
          "entity_id": "{{screen}}"
        }
      }
    },
    {
      "id": "screen_up",
      "label": {
        "en": "Screen up",
        "es": "Subir pantalla"
      },
      "icon": "blinds",
      "service": {
        "action": "cover.open_cover",
        "target": {
          "entity_id": "{{screen}}"
        }
      }
    },
    {
      "id": "projector_on",
      "label": {
        "en": "Projector on",
        "es": "Encender proyector"
      },
      "icon": "power",
      "service": {
        "action": "switch.turn_on",
        "target": {
          "entity_id": "{{projector_switch}}"
        }
      }
    },
    {
      "id": "projector_on_ir",
      "label": {
        "en": "Projector on (IR)",
        "es": "Encender proyector (IR)"
      },
      "icon": "power",
      "service": {
        "action": "remote.send_command",
        "target": {
          "entity_id": "{{ir_hub}}"
        },
        "data": {
          "device": "{{ir_device}}",
          "command": "{{ir_command}}"
        }
      }
    },
    {
      "id": "lights_off",
      "label": {
        "en": "Lights off",
        "es": "Apagar luces"
      },
      "icon": "brightness_down",
      "service": {
        "action": "light.turn_off",
        "target": {
          "entity_id": "{{lights}}"
        }
      }
    },
    {
      "id": "lights_up",
      "label": {
        "en": "Lights up",
        "es": "Luces al máximo"
      },
      "icon": "brightness_up",
      "service": {
        "action": "light.turn_on",
        "target": {
          "entity_id": "{{lights}}"
        },
        "data": {
          "brightness_pct": 100
        }
      }
    },
    {
      "id": "receiver_input",
      "label": {
        "en": "Receiver input",
        "es": "Entrada del receptor"
      },
      "icon": "input",
      "needs": [
        "movie_input"
      ],
      "service": {
        "action": "media_player.select_source",
        "target": {
          "entity_id": "{{receiver}}"
        },
        "data": {
          "source": "{{movie_input}}"
        }
      }
    }
  ]
}
