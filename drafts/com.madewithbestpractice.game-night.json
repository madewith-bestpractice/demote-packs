{
  "schema": 1,
  "id": "com.madewithbestpractice.game-night",
  "version": "0.1.0",
  "name": {
    "en": "Game night",
    "es": "Noche de juegos"
  },
  "description": {
    "en": "Set game lighting, the receiver's game input and sound mode, and the fan with Home Assistant.",
    "es": "Pon luces de juego, la entrada y el modo de sonido de juego del receptor y el ventilador con Home Assistant."
  },
  "vendor": "Home Assistant",
  "author": "Made with Best Practice",
  "icon": "scene",
  "accent": "pink",
  "engine": "home_assistant",
  "network": "local",
  "variables": [
    {
      "id": "lights",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Lights (a light or a group)",
        "es": "Luces (una luz o un grupo)"
      },
      "domain": "light"
    },
    {
      "id": "tv_light",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Light behind the TV, if any",
        "es": "Luz detrás de la TV, si tienes"
      },
      "domain": "light",
      "optional": true
    },
    {
      "id": "receiver",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Receiver, if any",
        "es": "Receptor, si tienes"
      },
      "domain": "media_player",
      "optional": true
    },
    {
      "id": "game_input",
      "scope": "pack",
      "type": "text",
      "label": {
        "en": "Receiver input for games",
        "es": "Entrada del receptor para juegos"
      },
      "placeholder": "Game",
      "optional": true
    },
    {
      "id": "game_sound",
      "scope": "pack",
      "type": "text",
      "label": {
        "en": "Sound mode for games",
        "es": "Modo de sonido para juegos"
      },
      "placeholder": "GAME",
      "optional": true
    },
    {
      "id": "fan",
      "scope": "pack",
      "type": "ha_entity",
      "label": {
        "en": "Fan, if any",
        "es": "Ventilador, si tienes"
      },
      "domain": "fan",
      "optional": true
    }
  ],
  "buttons": [
    {
      "id": "game_on",
      "label": {
        "en": "Game on",
        "es": "A jugar"
      },
      "icon": "scene",
      "steps": [
        { "button": "game_lights" },
        { "button": "tv_light_on" },
        { "button": "game_input", "delayMs": 1000 },
        { "button": "game_sound" }
      ]
    },
    {
      "id": "game_lights",
      "label": {
        "en": "Game lights",
        "es": "Luces de juego"
      },
      "icon": "lightbulb",
      "variables": [
        {
          "id": "color",
          "scope": "button",
          "type": "choice",
          "label": {
            "en": "Colour",
            "es": "Color"
          },
          "options": [
            {
              "value": "purple",
              "label": {
                "en": "Purple",
                "es": "Morado"
              }
            },
            {
              "value": "blue",
              "label": {
                "en": "Blue",
                "es": "Azul"
              }
            },
            {
              "value": "red",
              "label": {
                "en": "Red",
                "es": "Rojo"
              }
            },
            {
              "value": "lime",
              "label": {
                "en": "Green",
                "es": "Verde"
              }
            },
            {
              "value": "cyan",
              "label": {
                "en": "Cyan",
                "es": "Cian"
              }
            },
            {
              "value": "orange",
              "label": {
                "en": "Orange",
                "es": "Naranja"
              }
            },
            {
              "value": "deeppink",
              "label": {
                "en": "Pink",
                "es": "Rosa"
              }
            }
          ],
          "default": "purple"
        },
        {
          "id": "level",
          "scope": "button",
          "type": "number",
          "label": {
            "en": "Brightness (%)",
            "es": "Brillo (%)"
          },
          "min": 1,
          "max": 100,
          "default": 60
        }
      ],
      "service": {
        "action": "light.turn_on",
        "target": {
          "entity_id": "{{lights}}"
        },
        "data": {
          "color_name": "{{color}}",
          "brightness_pct": "{{level}}"
        }
      }
    },
    {
      "id": "tv_light_on",
      "label": {
        "en": "Behind-TV light on",
        "es": "Encender luz tras la TV"
      },
      "icon": "lightbulb",
      "service": {
        "action": "light.turn_on",
        "target": {
          "entity_id": "{{tv_light}}"
        }
      }
    },
    {
      "id": "game_input",
      "label": {
        "en": "Game input",
        "es": "Entrada de juego"
      },
      "icon": "input",
      "needs": [
        "game_input"
      ],
      "service": {
        "action": "media_player.select_source",
        "target": {
          "entity_id": "{{receiver}}"
        },
        "data": {
          "source": "{{game_input}}"
        }
      }
    },
    {
      "id": "game_sound",
      "label": {
        "en": "Game sound mode",
        "es": "Modo de sonido de juego"
      },
      "icon": "speaker",
      "needs": [
        "game_sound"
      ],
      "service": {
        "action": "media_player.select_sound_mode",
        "target": {
          "entity_id": "{{receiver}}"
        },
        "data": {
          "sound_mode": "{{game_sound}}"
        }
      }
    },
    {
      "id": "lights_normal",
      "label": {
        "en": "Lights normal",
        "es": "Luces normales"
      },
      "icon": "brightness_up",
      "variables": [
        {
          "id": "level",
          "scope": "button",
          "type": "number",
          "label": {
            "en": "Brightness (%)",
            "es": "Brillo (%)"
          },
          "min": 1,
          "max": 100,
          "default": 80
        }
      ],
      "service": {
        "action": "light.turn_on",
        "target": {
          "entity_id": "{{lights}}"
        },
        "data": {
          "color_temp_kelvin": 3000,
          "brightness_pct": "{{level}}"
        }
      }
    },
    {
      "id": "fan_on",
      "label": {
        "en": "Fan on",
        "es": "Encender ventilador"
      },
      "icon": "fan",
      "service": {
        "action": "fan.turn_on",
        "target": {
          "entity_id": "{{fan}}"
        }
      }
    },
    {
      "id": "fan_off",
      "label": {
        "en": "Fan off",
        "es": "Apagar ventilador"
      },
      "icon": "fan",
      "service": {
        "action": "fan.turn_off",
        "target": {
          "entity_id": "{{fan}}"
        }
      }
    }
  ]
}
